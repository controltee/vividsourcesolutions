{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./scripts/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.env)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [
        { "path": "./scripts/.env", "mode": "deny" }
      ]
    }
  }
}
